# Copy to .env.local for local development. Set the same values in Vercel.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=...

# DataForSEO (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Random string, 32+ chars. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/capture.
CRON_SECRET=

# Public URL of the deployed app (used in auth emails and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
